# Admin / auth
ADMIN_PASSWORD=
CRON_SECRET=

# Email (Gmail SMTP via nodemailer)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Notion
NOTION_API_KEY=
NOTION_LEADS_DB_ID=
NOTION_DRAFTS_DB_ID=
NOTION_BLOG_DB_ID=
NOTION_COACHING_CLIENTS_DB_ID=
NOTION_COACHING_SKILLS_DB_ID=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Payment Link for the $160 4-week Cohort Series (one-time charge).
# All-in price = $120 training + $40 tournament entry, bundled. Create in
# Stripe dashboard (Payment Links → New). Exposed to client because it's a
# public checkout URL. Leave empty to disable cohort signup.
NEXT_PUBLIC_COHORT_STRIPE_LINK=

# Community-OS Supabase (tqqhbccomjhfnylafwnk) — cross-app waiver writes only.
# sammorrispb writes cohort waivers to L&D's public.waivers table. Service-role
# key (bypasses RLS; server-side only). Mark sensitive in Vercel. Never expose
# to the client bundle. Leave empty to disable waiver capture.
SUPABASE_COMMUNITY_URL=
SUPABASE_COMMUNITY_SERVICE_KEY=

# Open Brain ingest
OPEN_BRAIN_INGEST_URL=
# Optional separate URL for the analytics-ingest edge function. If unset,
# /api/analytics will silently no-op.
OPEN_BRAIN_ANALYTICS_URL=
LEAD_INGEST_TOKEN=
